# ------------------------------------------------------------------
# PODIUM - .env de PRODUÇÃO (VM da Oracle)
# Na VM: cp deploy/production.env.example .env  e troque cada <...>.
# O que não está aqui usa o padrão de app/core/config.py.
# ------------------------------------------------------------------

# O `docker compose` passa a usar os dois arquivos sem precisar dos -f.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Nome público que aponta para o IP da VM (ex.: podium.duckdns.org). O Caddy pede o
# certificado HTTPS para ele.
DOMAIN=<seu-dominio>

# --- Aplicação ---
ENVIRONMENT=production
DEBUG=false

# --- Acesso ---
# A mesma chave vai no app (podium-vr: Assets/Podium/Resources/PodiumAccessKey.txt).
# Gerar com: openssl rand -hex 32
API_KEY=<chave-de-acesso>

# --- Banco ---
# O Postgres só lê a senha quando cria o volume, no primeiro `up`. Defina antes dele.
# Gerar com: openssl rand -hex 24
POSTGRES_USER=podium
POSTGRES_PASSWORD=<senha-do-banco>
POSTGRES_DB=podium
DATABASE_URL=postgresql+asyncpg://podium:<senha-do-banco>@db:5432/podium

# --- CORS ---
# A página /upload é servida pela própria API, então só a origem do domínio.
BACKEND_CORS_ORIGINS=["https://<seu-dominio>"]

# --- IA ---
GEMINI_API_KEY=<sua-chave-do-gemini>
