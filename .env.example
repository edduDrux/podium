# ------------------------------------------------------------------
# PODIUM - Backend API | Copie para `.env` e preencha os valores reais
# ------------------------------------------------------------------

# --- Aplicação ---
PROJECT_NAME=PODIUM API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Banco de Dados (PostgreSQL) ---
# Modo "tudo no Docker": host `db` (rede do Compose). Rodando fora do Docker: `localhost`.
POSTGRES_USER=podium
POSTGRES_PASSWORD=podium
POSTGRES_DB=podium
DATABASE_URL=postgresql+asyncpg://podium:podium@db:5432/podium

# --- CORS (origens permitidas para o Cliente VR / ferramentas) ---
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000"]

# --- IA: Google Gemini (free tier) ---
# Chave gratuita em https://aistudio.google.com/apikey (não exige cartão).
# LLM usa o endpoint compatível com OpenAI; STT usa a API nativa (Gemini não tem Whisper).
GEMINI_API_KEY=troque-por-sua-chave
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-flash-latest
STT_MODEL=gemini-flash-latest

# --- Armazenamento temporário de arquivos ---
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=25
MAX_AUDIO_DURATION_MINUTES=15
# Sessões mais antigas que isso têm PDF/PPTx e áudio apagados. 0 desativa.
STORAGE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
